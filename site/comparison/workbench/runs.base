# The runs workbench's .base, GENERATED by traj_compare.runs_workbench (write_runs_workbench). JSON is YAML.
{
 "data": "runs.json",
 "noun": [
  "run",
  "runs"
 ],
 "facets": [
  {
   "property": "config",
   "label": "Config"
  },
  {
   "property": "kind",
   "label": "Kind"
  },
  {
   "property": "target",
   "label": "Target"
  },
  {
   "property": "target_slug",
   "as": "search",
   "properties": [
    "target_slug",
    "run"
   ],
   "label": "Name search",
   "placeholder": "part of a target's or a run folder's name"
  }
 ],
 "properties": {
  "deployment": {
   "displayName": "Deployment"
  },
  "config": {
   "displayName": "Config"
  },
  "sim_real": {
   "displayName": "Sim / real"
  },
  "target": {
   "displayName": "Target"
  },
  "run_report": {
   "displayName": "Run report"
  },
  "dataset": {
   "displayName": "Dataset",
   "colors": {
    "workspace/v2 · UR5e": "#b92b2b"
   }
  }
 },
 "style": {
  "numbers": {
   "digits": 3
  }
 },
 "drill": {
  "actions": [
   {
    "label": "Open target view",
    "href": "target.html?site={site}&target={target_slug}",
    "title": "The target view of {target}: its runs, the ones the rail keeps ticked"
   },
   {
    "label": "Open run report ↗",
    "href": "{run_report|path}",
    "title": "This run's report (built on first open)"
   }
  ]
 },
 "datasets": {
  "runs": {
   "data": "runs.json",
   "label": "Runs"
  },
  "targets": {
   "data": "targets.json",
   "label": "Targets"
  }
 },
 "links": [
  {
   "from": "runs.target_key",
   "to": "targets.target_key",
   "direction": "one-way"
  }
 ],
 "pages": [
  {
   "name": "Overview",
   "layout": {
    "columns": 12,
    "rowHeight": 88,
    "panels": [
