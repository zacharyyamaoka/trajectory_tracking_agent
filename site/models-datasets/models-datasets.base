# Model × Dataset: one row per iteration (solution) nested under its family, one column per dev task grouped
# deployment › dataset › task kind › task; a cell is that task's number from solutions/<id>/scorecard.json.
# GENERATED by tools/build_dropins.py from the scorecards and meta.json: change the build, never this file.
# Family, by lineage: a generation-0 solution (tag gen-0: robot_controllers' P1–P10 configs) is in "generation 0"; an ablation (tag ablation) is in "ablations"; every other solution is in its lineage, named by the generation-0 solution reached by following its parents ("p5s lineage").
# Rank on the task: 1 + how many of the solutions (ablations left out) have a lower tool tracking RMS on that task; ties share a rank, an ablation is placed among the solutions, and a failed gate does not change it (the Gates failed view shows those).
# Check it: node <data-ui>/bin/data-ui.mjs check models-datasets.base
data: cells.json
facets:
  - family
  - gates
  - kind
  - iteration
properties:
  family: { displayName: Family }
  solution: { displayName: Iteration }
  iteration: { displayName: Kind of iteration }
  gates: { displayName: Gates }
  objective_mm: { displayName: 'Median of the dataset' }
  worst_task_mm: { displayName: Worst task }
  deployment: { displayName: Deployment }
  dataset: { displayName: Dataset }
  kind: { displayName: Task kind }
  task: { displayName: Task }
  verdict: { displayName: Gates on this task }
  failed_gates: { displayName: Failed gates }
  opens: { displayName: Opens }
  url: { displayName: Link }
  parent: { displayName: Parent }
  tool_track_rms_mm: { displayName: 'Tool tracking RMS' }
  rank_on_task: { displayName: 'Rank on the task' }
  stop_error_max_mm: { displayName: 'Worst stop error' }
  tool_track_max_mm: { displayName: 'Worst tool error' }
  saturation_share_pct: { displayName: 'Torque at cap' }
  joint_track_rms_deg: { displayName: 'Worst-joint tracking RMS' }
  failed_gate_count: { displayName: 'Gates failed' }
open: side
views:
  - type: pivot
    name: Per task
    filters: 'iteration == "solution"'
    order: [solution, gates, objective_mm, worst_task_mm]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: 'objective_mm', direction: ASC }
    fold: open
    splitBy: [dataset, kind, task]
    value: { property: tool_track_rms_mm, summary: Median }
    summaries:
      '@workspace/v2 / joint A→B moves / workspace-dev-003': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-005': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-006': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-007': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-008': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-010': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-011': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-013': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-014': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-015': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-022': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-024': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-025': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-026': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-027': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-028': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-031': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-032': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-033': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-034': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-036': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-037': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-038': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-041': Median
      '@workspace/v2 / straight tool lines / workspace-dev-002': Median
      '@workspace/v2 / straight tool lines / workspace-dev-004': Median
      '@workspace/v2 / straight tool lines / workspace-dev-009': Median
      '@workspace/v2 / straight tool lines / workspace-dev-012': Median
      '@workspace/v2 / straight tool lines / workspace-dev-018': Median
      '@workspace/v2 / straight tool lines / workspace-dev-020': Median
      '@workspace/v2 / straight tool lines / workspace-dev-021': Median
      '@workspace/v2 / straight tool lines / workspace-dev-030': Median
      '@workspace/v2 / via-point paths / workspace-dev-016': Median
      '@workspace/v2 / via-point paths / workspace-dev-017': Median
      '@workspace/v2 / via-point paths / workspace-dev-019': Median
      '@workspace/v2 / via-point paths / workspace-dev-023': Median
      '@workspace/v2 / via-point paths / workspace-dev-029': Median
      '@workspace/v2 / via-point paths / workspace-dev-035': Median
      '@workspace/v2 / via-point paths / workspace-dev-039': Median
