      '@workspace/v2 / joint A→B moves / workspace-dev-041': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-002': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-004': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-009': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-012': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-018': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-020': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-021': Sum
      '@workspace/v2 / straight tool lines / workspace-dev-030': Sum
      '@workspace/v2 / via-point paths / workspace-dev-016': Sum
      '@workspace/v2 / via-point paths / workspace-dev-017': Sum
      '@workspace/v2 / via-point paths / workspace-dev-019': Sum
      '@workspace/v2 / via-point paths / workspace-dev-023': Sum
      '@workspace/v2 / via-point paths / workspace-dev-029': Sum
      '@workspace/v2 / via-point paths / workspace-dev-035': Sum
      '@workspace/v2 / via-point paths / workspace-dev-039': Sum
      '@workspace/v2 / via-point paths / workspace-dev-040': Sum
      '@workspace/v2 / ISO 9283 path / workspace-dev-000': Sum
      '@workspace/v2 / ISO 9283 cube / workspace-dev-001': Sum
  - type: pivot
    name: With ablations
    order: [solution, iteration, gates, objective_mm, worst_task_mm]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
