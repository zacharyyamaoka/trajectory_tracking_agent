    fold: open
    splitBy: [dataset, kind, task]
    value: { property: tool_track_rms_mm, summary: Median }
    summaries:
      '@workspace/v2 / joint A→B moves / workspace-dev-003': Median
      '@workspace/v2 / joint A→B moves / workspace-dev-005': Median
