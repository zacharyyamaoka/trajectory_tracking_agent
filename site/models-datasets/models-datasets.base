      '@workspace/v2 / ISO 9283 path / workspace-dev-000': Median
      '@workspace/v2 / ISO 9283 cube / workspace-dev-001': Median
  - type: pivot
    name: Per task kind
    filters: 'iteration == "solution"'
    order: [solution, gates, objective_mm]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: 'objective_mm', direction: ASC }
    fold: open
    splitBy: [dataset, kind]
    value: { property: tool_track_rms_mm, summary: Median }
    summaries:
      '@workspace/v2 / joint A→B moves': Median
      '@workspace/v2 / straight tool lines': Median
      '@workspace/v2 / via-point paths': Median
      '@workspace/v2 / ISO 9283 path': Median
      '@workspace/v2 / ISO 9283 cube': Median
  - type: pivot
    name: Per dataset (median)
    filters: 'iteration == "solution"'
    order: [solution, gates]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: '@ur5e_alone / workspace/v2', direction: ASC }
    fold: open
    splitBy: [deployment, dataset]
    value: { property: tool_track_rms_mm, summary: Median }
    summaries:
      '@ur5e_alone / workspace/v2': Median
  - type: pivot
    name: Per dataset (mean)
    filters: 'iteration == "solution"'
    order: [solution, gates]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: '@ur5e_alone / workspace/v2', direction: ASC }
    fold: open
    splitBy: [deployment, dataset]
    value: { property: tool_track_rms_mm, summary: Average }
    summaries:
      '@ur5e_alone / workspace/v2': Average
  - type: pivot
    name: Per dataset (mean rank)
    filters: 'iteration == "solution"'
    order: [solution, gates]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: '@ur5e_alone / workspace/v2', direction: ASC }
    fold: open
    splitBy: [deployment, dataset]
    value: { property: rank_on_task, summary: Average }
    summaries:
      '@ur5e_alone / workspace/v2': Average
  - type: pivot
    name: Gates failed
    filters: 'iteration == "solution"'
    order: [solution, gates]
    groupBy: { property: family }
    groupOrder: [p5s lineage, generation 0, ablations]
    sort:
      - { property: 'objective_mm', direction: ASC }
    fold: open
    splitBy: [dataset, kind, task]
    value: { property: failed_gate_count, summary: Max }
    summaries:
      '@workspace/v2 / joint A→B moves / workspace-dev-003': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-005': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-006': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-007': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-008': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-010': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-011': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-013': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-014': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-015': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-022': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-024': Sum
      '@workspace/v2 / joint A→B moves / workspace-dev-025': Sum
