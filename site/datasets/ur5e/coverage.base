# The coverage workbench: data-ui's <data-workbench> over these trajectories (data-ui docs/CONTRACT.md §52, §53).
# GENERATED by traj_compare.coverage.workbench.write_workbench (docs/COVERAGE.md "The workbench"): change the writer,
# never this file. The rail filters trajectories, Dataset first; every tab is a dashboard over what the rail keeps, and
# each coverage figure adds up the kept trajectories' part rows (coverage.sum), so a tick recounts every tab. One joint
# has a Joint picker of its own; the gear sets the heatmap colours for every tab at once.
#
# WHY trajectories in the rail and parts in the figures (Zach, 2026-11-24): "the atomic unit here is trajectories", and
# "the dev/holdout will apply then to all of the datasets you include".
data: trajectories.json
noun: [trajectory, trajectories]
facets:
  - { property: deployment, label: Deployment, order: [ur5e_alone] }
  - { property: dataset, label: Dataset, order: [ur5e_alone/workspace/v2] }
  - { property: split, label: Split, order: [dev, holdout] }
  - { property: kind, label: Kind }
  - { property: name, as: search, label: Find a trajectory, placeholder: e.g. ur5e_alone/workspace-dev-000 }
  - { property: duration_s, as: slider-histogram, label: Duration, unit: s, collapsed: true }
  - { property: new_cells, as: slider-histogram, label: New cells, collapsed: true }
  - { property: tool_path_m, as: slider-histogram, label: Tool path, unit: m, collapsed: true }
properties:
  name: { displayName: Trajectory }
  dataset: { displayName: Dataset, colors: { ur5e_alone/workspace/v2: 1 } }
  split: { displayName: Split, colors: { dev: 5, holdout: 4 } }
style:
  numbers: { digits: 3 }
  families: { property: dataset, colors: { ur5e_alone/workspace/v2: 1 } }
  heatmap: { colormap: viridis, reverse: false, scale: linear }
settings: [heatmap.colormap, heatmap.reverse, heatmap.scale]
drill: { actions: [{ label: Copy its name, copy: '{name}', title: 'Copies {name}' }] }
datasets: { parts: { data: parts.json, label: Coverage parts } }
links: [{ from: trajectories.id, to: parts.trajectory, direction: one-way }]
pages:
  - name: Overview
    layout:
      columns: 12
      rowHeight: 96
      panels:
        - { view: Every joint, w: 8, h: 5, title: Every joint · position × speed }
        - { view: Trajectories per dataset, w: 4, h: 2 }
        - { view: The tool from above, w: 4, h: 3 }
        - { view: Every joint against its limits, w: 8, h: 4 }
        - { view: Which way the tool points, w: 4, h: 4 }
  - name: One joint
    datasets:
      parts:
        facets:
          - property: joint
            as: select
            label: Joint
            dropdown: true
            order: [shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint]
        filters: 'joint == "shoulder_pan_joint"'
    layout:
      columns: 12
      rowHeight: 96
      panels:
        - { view: Position × speed, w: 6, h: 4 }
        - { view: Speed × acceleration, w: 6, h: 4 }
        - { view: Position × acceleration, w: 6, h: 4 }
        - { view: Against the limits, w: 6, h: 4 }
  - name: Limits
    layout:
      columns: 12
      rowHeight: 96
      panels:
        - { view: 'Every joint, every signal', w: 12, h: 7, style: { title: none } }
  - name: Tool position
    layout:
      columns: 12
      rowHeight: 96
      panels:
        - { view: The tool from three sides, w: 12, h: 5, style: { title: none } }
        - { view: Tool speed, w: 12, h: 3 }
  - name: Tool orientation
    layout:
      columns: 12
      rowHeight: 96
      panels:
        - { view: Which way the tool points, w: 5, h: 5 }
        - { view: 'Every direction, equal area', w: 7, h: 5 }
        - { view: Tilt × yaw, w: 12, h: 4 }
  - name: Trajectories
    layout: { columns: 12, rowHeight: 96, panels: [{ view: Trajectories, w: 12, h: 6, style: { title: none } }] }
views:
  - type: chart
    name: Trajectories per dataset
    chart:
      mark: bar
      encoding:
        'y': { field: dataset, title: null }
        x: { aggregate: count, title: trajectories }
        color: { field: split, title: Split }
  - type: coverage-plane
    name: Every joint
    from: parts
    filters: 'kind == "q_qd"'
    sort: [{ property: joint_order, direction: ASC }]
    coverage: { sum: grid, title: joint, columns: 3 }
  - type: coverage-hist
    name: Every joint against its limits
    from: parts
    filters: 'kind == "hist"'
    sort: [{ property: joint_order, direction: ASC }, { property: signal_order, direction: ASC }]
    coverage: { sum: grid, layout: ridgeline, card: joint, signals: [q, qd, qdd] }
  - type: coverage-plane
    name: Position × speed
    from: parts
    filters: 'kind == "q_qd"'
    coverage: { sum: grid }
  - type: coverage-plane
    name: Speed × acceleration
    from: parts
    filters: 'kind == "qd_qdd"'
    coverage: { sum: grid }
  - type: coverage-plane
    name: Position × acceleration
    from: parts
    filters: 'kind == "q_qdd"'
    coverage: { sum: grid }
  - type: coverage-hist
    name: Against the limits
    from: parts
    filters: 'kind == "hist"'
    sort: [{ property: signal_order, direction: ASC }]
    coverage: { sum: grid, card: joint, columns: 1 }
  - type: coverage-hist
    name: 'Every joint, every signal'
    from: parts
    filters: 'kind == "hist"'
    sort: [{ property: joint_order, direction: ASC }, { property: signal_order, direction: ASC }]
    coverage: { sum: grid, card: joint }
  - type: coverage-projection
    name: The tool from above
    from: parts
    filters: 'kind == "tool" && grid == "xy"'
    coverage: { sum: grid }
  - type: coverage-projection
    name: The tool from three sides
    from: parts
    filters: 'kind == "tool"'
    coverage: { sum: grid }
  - type: coverage-hist
    name: Tool speed
    from: parts
    filters: 'kind == "tool_speed"'
    coverage: { sum: grid }
  - type: coverage-polar
    name: Which way the tool points
    from: parts
    filters: 'kind == "pointing"'
    coverage: { sum: grid }
  - type: coverage-plane
    name: 'Every direction, equal area'
    from: parts
    filters: 'kind == "sphere"'
    coverage: { sum: grid }
  - type: coverage-plane
    name: Tilt × yaw
    from: parts
    filters: 'kind == "tilt_yaw"'
    coverage: { sum: grid }
  - type: table
    name: Trajectories
    order:
      - name
      - dataset
      - split
      - kind
      - duration_s
      - samples
      - new_cells
      - tool_path_m
      - tool_speed_max_m_s
      - tool_tilt_max_deg
      - deployment
    display: { dataset: badge, split: badge, new_cells: bar }
